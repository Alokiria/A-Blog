# 本项目使用 npm 安装依赖（见 README「包管理器」一节）。
#
# legacy-peer-deps：
# valaxy-addon-bangumi / valaxy-addon-algolia 等插件声明的 peer 是
# `valaxy: ">=0.22"`，而 semver 默认不把 1.0.0-rc.16 这类预发布版本算作满足
# `>=0.22`，npm 会直接 ERESOLVE 失败。这里放宽 peer 检查。
legacy-peer-deps=true

# 以下两项是给 pnpm 用的（pnpm 10 及更早版本会读 .npmrc）。
# Valaxy 1.0 的 CLI / 主题 / 插件在运行期用 Node 原生 ESM 解析加载依赖
# （例如 node_modules/valaxy/bin/valaxy.mjs → yargs），pnpm 默认的 isolated
# 链接模式不会把这些传递依赖暴露到根 node_modules，会 ERR_MODULE_NOT_FOUND。
node-linker=hoisted
strict-peer-dependencies=false
